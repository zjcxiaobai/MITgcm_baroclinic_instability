# Model parameters
# Continuous equation parameters
 &PARM01

 debuglevel=-1,
 readBinaryPrec=32,
 writeBinaryPrec=32,
 
# parameters for EOS
 buoyancyRelation='OCEANIC', 
 eosType='JMD95Z',
 tRef=49*5.,
 sRef=49*34.,
 
# run a non-hydrostatic simulation, requires define ALLOW_NONHYDROSTATIC
 nonHydrostatic=.FALSE.,

# Viscosity
# viscAh=2000.,
 viscAr=1.E-3,
 implicitViscosity=.TRUE.,
# Diffusivity and convection
 diffKhT=0.,
 diffKrT=4.E-7,
 diffKhS=0.,
 diffKrS=3.E-7,
# ivdc_kappa=1., # comment if you use kpp
 implicitDiffusion=.TRUE.,
# Coriolis parameter
 f0=-1.363e-4,
 beta=1.313e-11,
 selectCoriScheme=1,

 no_slip_sides = .TRUE.,
 no_slip_bottom = .TRUE.,

# Density and equation of state
# Temp only active tracer, no salinity
 rhoConst=1035.,
 rhoNil=1027.5,
 saltStepping=.TRUE.,
 tempStepping=.TRUE.,

# activate partial cells
 hFacMinDr=5.,
 hFacMin=0.1,
 hFacInf= 0.05,
 hFacSup= 5.0,

# free surface parameters
 rigidLid=.FALSE.,
 implicitFreeSurface=.TRUE.,
 exactConserv=.TRUE.,
# advection scheme
 tempAdvScheme=7,
 saltAdvScheme=7,
 staggerTimeStep=.TRUE.,

#---------------------------------------
#- for non-GM coarse run, set horizontal diffusivity non-zero:
# diffKhT=1000.,
#
#- for eddy-permitting run, uncomment the following:
 viscC4Leith = 2.5,
 viscA4GridMax = 0.8,
 useSingleCpuIO=.TRUE.,
 viscAh = 10.0,
 useFullLeith=.TRUE.,
 useAreaViscLength = .TRUE.,

 highOrderVorticity     = .TRUE.,
 multiDimAdvection      = .TRUE.,
 vectorInvariantMomentum= .TRUE.,
#- and comment out above statement viscAh=2000.,
 &

# Elliptic solver parameters
 &PARM02
 cg2dTargetResidual=1.E-5,
 cg2dMaxIters=100,
 cg3dMaxIters=100,
 cg3dTargetResidual=1.E-9,
 &

